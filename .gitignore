# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/

# netmon 运行数据 —— 含本机 IP / MAC / 无线信息，绝不入库
data/
data-*/
*.log

# 报告是生成物，只保留合成样例用于展示
reports/*
!reports/demo-report.html

# 本地配置覆盖（config.json 本身是模板，需要入库）
config.local.json

# 编辑器
.vscode/
.idea/
*.swp

# AI 助手工作目录（会话记忆，非项目代码）
.workbuddy/

# 早期截图含真实内网地址，不入库
docs/screenshot.png

# 桌面版打包产物（可由 packaging/build_app.py 重新生成）
dist/
packaging/NetMon.iconset/
packaging/*.icns
packaging/netmon.png
