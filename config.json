    "degraded_streak": 2,
    "bleep_ticks": 1
  },
  "wifi": {
    "enabled": true,
    "sample_every_ticks": 2,
    "scan_neighbors": false
  },
  "forensics": {
    "traceroute_on_incident": true,
    "traceroute_target": "223.5.5.5",
    "traceroute_max_hops": 12,
    "traceroute_timeout_seconds": 25,
    "cooldown_seconds": 600,
    "capture_snapshot": true
