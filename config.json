  "dns": {
    "names": [
      "www.baidu.com",
      "www.aliyun.com"
    ],
    "external_servers": [
      "223.5.5.5"
    ],
    "timeout_seconds": 3
  },
  "http": {
    "urls": [
      "http://connect.rom.miui.com/generate_204",
      "http://wifi.vivo.com.cn/generate_204"
    ],
    "timeout_seconds": 4
  },
  "thresholds": {
    "rtt_warn_ms": 150,
    "rtt_bad_ms": 400,
    "loss_warn_pct": 20.0,
    "jitter_warn_ms": 60.0,
    "rssi_warn_dbm": -70,
    "rssi_bad_dbm": -80,
    "noise_bad_dbm": -85,
